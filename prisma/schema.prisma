generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int       @id @default(autoincrement())
  firstName           String
  lastName            String
  email               String    @unique
  password            String
  image               String?
  role                Role      @default(MEMBER)
  province            String?
  amphoe              String?
  district            String?
  zone                String?
  emailVerified       DateTime?
  resetToken          String?   @unique
  resetTokenCreatedAt DateTime?
  resetTokenExpiresAt DateTime?
  lastPasswordReset   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  villages            Village[]

  @@index([email])
  @@index([role])
}

model Village {
  id                   Int                   @id @default(autoincrement())
  villageName          String
  villageNo            String
  tambon               String
  amphoe               String
  province             String
  zone                 String
  coordinator          String
  phone                String?
  registeredPopulation Int                   @default(0)
  actualPopulation     Int                   @default(0)
  householdCount       Int                   @default(0)
  creatorId            Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  communityBackgrounds CommunityBackground[]
  communityOrgs        CommunityOrg[]
  envItems             EnvItem[]
  persons              Person[]
  screeningResults     ScreeningResult[]
  creator              User?                 @relation(fields: [creatorId], references: [id])

  @@index([province])
  @@index([amphoe])
  @@index([tambon])
  @@index([creatorId])
}

model ScreeningResult {
  id              Int     @id @default(autoincrement())
  villageId       Int
  year            Int
  screenedCount   Int     @default(0)
  alcoholRiskLow  Int     @default(0)
  alcoholRisk     Int     @default(0)
  alcoholDanger   Int     @default(0)
  alcoholAddicted Int     @default(0)
  alcoholNone     Int     @default(0)
  tobaccoCount    Int     @default(0)
  tobaccoNone     Int     @default(0)
  drinkAndDrive   Int     @default(0)
  drinkNotDriveN  Int     @default(0)
  village         Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@unique([villageId, year])
  @@index([villageId])
}

model CommunityBackground {
  id        Int     @id @default(autoincrement())
  villageId Int
  itemType  String
  hasItem   Boolean @default(false)
  fileUrl   String?
  fileName  String?
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@unique([villageId, itemType])
  @@index([villageId])
}


model EnvItem {
  id               Int      @id @default(autoincrement())
  villageId        Int
  itemType         String
  hasItem          Boolean  @default(false)
  hasPolicy            Boolean? // งานศพ: มีนโยบาย
  policyFileUrl        String?
  policyFileName       String?
  hasCommunityRule     Boolean? // งานศพ: มีกติกาชุมชน
  communityRuleFileUrl  String?
  communityRuleFileName String?
  hasTraditionEvent   Boolean? // งานประเพณี: มีงานประเพณี
  traditionEventNames String?  @db.Text // งานประเพณี: ชื่องาน (JSON string[])
  hasNoDrinkSite      Boolean? // งานประเพณี: มีสถานที่ห้ามดื่มห้ามขาย
  noDrinkSiteNames    String?  @db.Text // งานประเพณี: ชื่อสถานที่ห้ามขาย-ห้ามดื่ม (JSON string[])
  noAlcohol        Boolean? // ร้านค้า: ไม่ขายเหล้าเลย
  shopNames        String?  @db.Text // ร้านค้า: ชื่อร้าน (JSON string[])
  hasShopLegal     Boolean? // ร้านค้า: ร้านขายเข้าร่วมตามกฎหมาย
  shopLegalNames   String?  @db.Text // ร้านค้า: ชื่อร้านเข้าร่วมตามกฎหมาย (JSON string[])
  village          Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@unique([villageId, itemType])
  @@index([villageId])
}

model CommunityOrg {
  id               Int     @id @default(autoincrement())
  villageId        Int
  orgType          String
  hasParticipation Boolean @default(false)
  orgNames         String?  @db.Text // JSON string[]
  village          Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@unique([villageId, orgType])
  @@index([villageId])
}

model Person {
  id        Int             @id @default(autoincrement())
  villageId Int
  name      String
  gender    String?
  createdAt DateTime        @default(now())
  village   Village         @relation(fields: [villageId], references: [id], onDelete: Cascade)
  alcohol   PersonAlcohol?
  dnd       PersonDnd?
  tobacco   PersonTobacco?
  outcomes  PersonOutcome[]

  @@index([villageId])
}

model PersonOutcome {
  id          Int     @id @default(autoincrement())
  personId    Int
  group       String  // 'alcohol' | 'tobacco'
  year        Int     // 1 | 2 | 3
  outcomeType String  // 'Money' | 'Property' | 'Family' | 'Health' | 'Work' | 'Accepted' | 'Other'
  hasIt       Boolean @default(false)
  detail      String? @db.LongText
  moneyNote   String? @db.LongText
  person      Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, group, year, outcomeType])
  @@index([personId])
  @@index([personId, group])
}

model PersonAlcohol {
  id        Int     @id @default(autoincrement())
  personId  Int     @unique
  drinkType String  @default("เสี่ยงต่ำ")
  statusY1  String  @default("ตั้งใจเลิก")
  statusY2  String?
  statusY3  String?
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model PersonTobacco {
  id        Int     @id @default(autoincrement())
  personId  Int     @unique
  smokeType String  @default("สูบประจำ")
  statusY1  String  @default("ตั้งใจเลิก")
  statusY2  String?
  statusY3  String?
  noteY1    String? @db.LongText
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model PersonDnd {
  id          Int     @id @default(autoincrement())
  personId    Int     @unique
  drinkType   String  @default("เสี่ยงต่ำ")
  year1Result String? @db.LongText
  year2Result String? @db.LongText
  year3Result String? @db.LongText
  person      Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
}

enum Role {
  MEMBER
  ADMIN
}
