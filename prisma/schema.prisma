generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int       @id @default(autoincrement())
  firstName           String
  lastName            String
  email               String    @unique
  password            String
  image               String?
  role                Role      @default(MEMBER)
  province            String?
  amphoe              String?
  district            String?
  zone                String?
  emailVerified       DateTime?
  resetToken          String?   @unique
  resetTokenCreatedAt DateTime?
  resetTokenExpiresAt DateTime?
  lastPasswordReset   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  villages            Village[]

  @@index([email])
  @@index([role])
}

model Village {
  id                   Int                   @id @default(autoincrement())
  villageName          String
  villageNo            String
  tambon               String
  amphoe               String
  province             String
  zone                 String
  coordinator          String
  phone                String?
  registeredPopulation Int                   @default(0)
  actualPopulation     Int                   @default(0)
  householdCount       Int                   @default(0)
  creatorId            Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  alcoholMembers       AlcoholMember[]
  communityBackgrounds CommunityBackground[]
  communityOrgs        CommunityOrg[]
  drinkNotDriveMembers DrinkNotDriveMember[]
  envItems             EnvItem[]
  persons              Person[]
  screeningResults     ScreeningResult[]
  tobaccoMembers       TobaccoMember[]
  creator              User?                 @relation(fields: [creatorId], references: [id])

  @@index([province])
  @@index([amphoe])
  @@index([tambon])
  @@index([creatorId])
}

model ScreeningResult {
  id              Int     @id @default(autoincrement())
  villageId       Int
  year            Int
  screenedCount   Int     @default(0)
  alcoholRiskLow  Int     @default(0)
  alcoholRisk     Int     @default(0)
  alcoholDanger   Int     @default(0)
  alcoholAddicted Int     @default(0)
  alcoholNone     Int     @default(0)
  tobaccoCount    Int     @default(0)
  tobaccoNone     Int     @default(0)
  drinkAndDrive   Int     @default(0)
  drinkNotDriveN  Int     @default(0)
  village         Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@unique([villageId, year])
  @@index([villageId])
}

model CommunityBackground {
  id        Int     @id @default(autoincrement())
  villageId Int
  itemType  String
  hasItem   Boolean @default(false)
  fileUrl   String?
  fileName  String?
  village   Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@unique([villageId, itemType])
  @@index([villageId])
}

model AlcoholMember {
  id          Int      @id @default(autoincrement())
  villageId   Int
  name        String
  drinkType   String
  status      String?
  y1Money     Boolean  @default(false)
  y1Property  Boolean  @default(false)
  y1Family    Boolean  @default(false)
  y1Health    Boolean  @default(false)
  y1Work      Boolean  @default(false)
  y1Accepted  Boolean  @default(false)
  y1Other     Boolean  @default(false)
  y1OtherText String?  @db.Text
  y2Money     Boolean  @default(false)
  y2Property  Boolean  @default(false)
  y2Family    Boolean  @default(false)
  y2Health    Boolean  @default(false)
  y2Work      Boolean  @default(false)
  y2Accepted  Boolean  @default(false)
  y2Other     Boolean  @default(false)
  y2OtherText String?  @db.Text
  y3Money     Boolean  @default(false)
  y3Property  Boolean  @default(false)
  y3Family    Boolean  @default(false)
  y3Health    Boolean  @default(false)
  y3Work      Boolean  @default(false)
  y3Accepted  Boolean  @default(false)
  y3Other     Boolean  @default(false)
  y3OtherText String?  @db.Text
  createdAt   DateTime @default(now())
  village     Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@index([villageId])
}

model TobaccoMember {
  id             Int      @id @default(autoincrement())
  villageId      Int
  name           String
  smokeType      String
  y1Money        Boolean  @default(false)
  y1MoneyText    String?  @db.Text
  y1Property     Boolean  @default(false)
  y1PropertyText String?  @db.Text
  y1Family       Boolean  @default(false)
  y1FamilyText   String?  @db.Text
  y1Health       Boolean  @default(false)
  y1HealthText   String?  @db.Text
  y1Work         Boolean  @default(false)
  y1WorkText     String?  @db.Text
  y1Accepted     Boolean  @default(false)
  y1AcceptedText String?  @db.Text
  y1Other        Boolean  @default(false)
  y1OtherText    String?  @db.Text
  y2Money        Boolean  @default(false)
  y2MoneyText    String?  @db.Text
  y2Property     Boolean  @default(false)
  y2PropertyText String?  @db.Text
  y2Family       Boolean  @default(false)
  y2FamilyText   String?  @db.Text
  y2Health       Boolean  @default(false)
  y2HealthText   String?  @db.Text
  y2Work         Boolean  @default(false)
  y2WorkText     String?  @db.Text
  y2Accepted     Boolean  @default(false)
  y2AcceptedText String?  @db.Text
  y2Other        Boolean  @default(false)
  y2OtherText    String?  @db.Text
  y3Money        Boolean  @default(false)
  y3MoneyText    String?  @db.Text
  y3Property     Boolean  @default(false)
  y3PropertyText String?  @db.Text
  y3Family       Boolean  @default(false)
  y3FamilyText   String?  @db.Text
  y3Health       Boolean  @default(false)
  y3HealthText   String?  @db.Text
  y3Work         Boolean  @default(false)
  y3WorkText     String?  @db.Text
  y3Accepted     Boolean  @default(false)
  y3AcceptedText String?  @db.Text
  y3Other        Boolean  @default(false)
  y3OtherText    String?  @db.Text
  createdAt      DateTime @default(now())
  village        Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@index([villageId])
}

model DrinkNotDriveMember {
  id          Int      @id @default(autoincrement())
  villageId   Int
  name        String
  drinkType   String
  year1Result String?  @db.Text
  year2Result String?  @db.Text
  year3Result String?  @db.Text
  createdAt   DateTime @default(now())
  village     Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@index([villageId])
}

model EnvItem {
  id               Int      @id @default(autoincrement())
  villageId        Int
  itemType         String
  hasItem          Boolean  @default(false)
  result1          String?  @db.Text
  result2          String?  @db.Text
  result3          String?  @db.Text
  hasPolicy            Boolean? // งานศพ: มีนโยบาย
  policyFileUrl        String?
  policyFileName       String?
  hasCommunityRule     Boolean? // งานศพ: มีกติกาชุมชน
  communityRuleFileUrl  String?
  communityRuleFileName String?
  noAlcohol        Boolean? // ร้านค้า: ไม่ขายเหล้าเลย
  shopNames        String?  @db.Text // ร้านค้า: ชื่อร้าน (JSON string[])
  hasShopLegal     Boolean? // ร้านค้า: ร้านขายเข้าร่วมตามกฎหมาย
  shopLegalNames   String?  @db.Text // ร้านค้า: ชื่อร้านเข้าร่วมตามกฎหมาย (JSON string[])
  village          Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@unique([villageId, itemType])
  @@index([villageId])
}

model CommunityOrg {
  id               Int     @id @default(autoincrement())
  villageId        Int
  orgType          String
  hasParticipation Boolean @default(false)
  orgNames         String?  @db.Text // JSON string[]
  result1          String? @db.Text
  result2          String? @db.Text
  result3          String? @db.Text
  village          Village @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@unique([villageId, orgType])
  @@index([villageId])
}

model Person {
  id        Int            @id @default(autoincrement())
  villageId Int
  name      String
  gender    String?
  createdAt DateTime       @default(now())
  village   Village        @relation(fields: [villageId], references: [id], onDelete: Cascade)
  alcohol   PersonAlcohol?
  dnd       PersonDnd?
  tobacco   PersonTobacco?

  @@index([villageId])
}

